# =====================================================================
# Automated Grading System -- database connection template
#
# Copy this file to `.env` and fill in the real password.
# NEVER commit `.env` -- add it to .gitignore.
# =====================================================================

# --- MySQL connection -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ags_db
DB_USER=ags_app
DB_PASSWORD=ChangeMe_AGS_2026!
DB_CHARSET=utf8mb4

# Ready-made SQLAlchemy URL for the Flask backend.
# Requires: pip install flask-sqlalchemy pymysql cryptography
# (`cryptography` is what lets PyMySQL speak MySQL 8's default
#  caching_sha2_password auth -- without it you get a confusing
#  "cryptography package is required" error at connect time.)
DATABASE_URL=mysql+pymysql://ags_app:ChangeMe_AGS_2026!@127.0.0.1:3306/ags_db?charset=utf8mb4

# --- File storage -----------------------------------------------------
# The database stores paths, not images. These are the folders those
# paths are relative to. Back them up alongside the SQL dump -- a
# database backup on its own does not contain the scans.
UPLOAD_DIR=./storage/uploads
CROP_DIR=./storage/crops
EXPORT_DIR=./storage/exports

# --- Flask ------------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-64-character-hex-string
FLASK_ENV=development
