# =====================================================================
# FastAPI backend -- connection template
#
# Copy this file to `.env` and fill in the real password (the same one
# set for `ags_app` in database/SETUP.md section 3). NEVER commit `.env`.
# =====================================================================

# --- MySQL connection -------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ags_db
DB_USER=ags_app
DB_PASSWORD=ChangeMe_AGS_2026!
DB_CHARSET=utf8mb4

DATABASE_URL=mysql+pymysql://ags_app:ChangeMe_AGS_2026!@127.0.0.1:3306/ags_db?charset=utf8mb4

# --- File storage -------------------------------------------------------
# Paths only go in the database; these are the folders they are relative to.
UPLOAD_DIR=./storage/uploads
CROP_DIR=./storage/crops
EXPORT_DIR=./storage/exports

# --- Session auth -------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-64-character-hex-string
# Keep false for local http://localhost dev. Set to true once this is
# deployed behind real HTTPS -- otherwise the session cookie can be read
# over an unencrypted connection (e.g. public wifi).
SESSION_COOKIE_SECURE=false

# --- CORS -----------------------------------------------------------
# Origin of the Vue dev server. Only needed if you don't use the Vite
# proxy (vue-app/vite.config.js server.proxy) -- the proxy avoids CORS
# entirely by making requests look same-origin.
FRONTEND_ORIGIN=http://localhost:5173

# --- Email (verification codes / password reset) ------------------------
# Gmail SMTP with an app password -- NOT your normal Gmail password. See
# SETUP.md for how to generate one (Google Account > Security > 2-Step
# Verification > App Passwords). This account is who the emails come
# FROM; it has nothing to do with any teacher's own email address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.sending.address@gmail.com
SMTP_APP_PASSWORD=replace-me-with-the-16-character-app-password
FROM_EMAIL=your.sending.address@gmail.com
